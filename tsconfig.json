{
    "extends": "@jubstaaa/config/tsconfig/node",
    "compilerOptions": {
        "lib": ["dom", "dom.iterable", "esnext"],
        "types": ["vite/client", "bun"],
        "verbatimModuleSyntax": false,
        "jsx": "react-jsx",
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["src", "e2e", "scripts", "*.ts", "*.mts"],
    "exclude": ["node_modules", "dist"]
}
