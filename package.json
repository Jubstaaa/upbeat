{
    "name": "upbeat",
    "version": "1.0.1",
    "private": true,
    "type": "module",
    "description": "A beautiful, animated status page for UptimeRobot. Deploy to Vercel, Cloudflare or Docker with one API key.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Jubstaaa/upbeat.git"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "start": "bun src/server/bun.ts",
        "deploy": "vite build && wrangler deploy",
        "lint": "eslint",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@sindresorhus/slugify": "^3.0.1",
        "@tanstack/react-query": "^5.104.3",
        "badge-maker": "^6.0.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "d3-scale": "^4.0.2",
        "d3-shape": "^3.2.0",
        "dayjs": "^1.11.23",
        "feed": "^6.0.0",
        "hono": "^4.13.13",
        "lucide-react": "^1.59.0",
        "motion": "^14.3.0",
        "radix-ui": "^1.8.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tailwind-merge": "^3.7.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.64.0",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.64.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/bun": "^1.4.3",
        "@types/d3-scale": "^4.0.9",
        "@types/d3-shape": "^3.2.0",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-perfectionist": "^5.12.1",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.13.0",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.71.2",
        "vite": "^8.3.4",
        "vitest": "^5.0.5",
        "wrangler": "^4.151.1"
    },
    "cloudflare": {
        "bindings": {
            "UPTIMEROBOT_API_KEY": {
                "description": "A **read-only** API key from UptimeRobot → [Integrations & API](https://dashboard.uptimerobot.com/integrations)."
            }
        }
    }
}
