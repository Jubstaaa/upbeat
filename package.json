{
    "name": "upbeat",
    "version": "1.0.5",
    "packageManager": "bun@1.4.4",
    "private": true,
    "type": "module",
    "description": "A beautiful, animated status page for UptimeRobot. Deploy to Vercel, Cloudflare or Docker with one API key.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Jubstaaa/upbeat.git"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "start": "bun src/server/bun.ts",
        "deploy": "vite build && wrangler deploy",
        "lint": "eslint",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "audit": "bun audit --audit-level=high",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@hono/bun": "^1.0.1",
        "@hono/node-server": "^2.1.8",
        "@sindresorhus/slugify": "^4.0.1",
        "@tanstack/react-query": "^5.108.1",
        "badge-maker": "^6.0.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "d3-scale": "^4.0.3",
        "d3-shape": "^3.2.1",
        "dayjs": "^1.11.23",
        "feed": "^6.0.0",
        "hono": "^4.13.18",
        "lucide-react": "^1.72.0",
        "motion": "^14.14.0",
        "radix-ui": "^1.8.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tailwind-merge": "^3.7.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@cloudflare/vite-plugin": "^1.70.1",
        "@jubstaa/config": "^1.6.0",
        "@playwright/test": "^1.65.0",
        "@tailwindcss/vite": "^4.3.5",
        "@types/bun": "^1.4.4",
        "@types/d3-scale": "^4.0.9",
        "@types/d3-shape": "^3.2.0",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitejs/plugin-react": "^6.3.0",
        "eslint": "^10.15.0",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.18.1",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.8",
        "prettier": "^3.10.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.5",
        "tw-animate-css": "^1.4.0",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "vite": "^8.3.8",
        "vitest": "^5.1.1",
        "wrangler": "^4.165.0"
    },
    "cloudflare": {
        "bindings": {
            "UPTIMEROBOT_API_KEY": {
                "description": "A **read-only** API key from UptimeRobot → [Integrations & API](https://dashboard.uptimerobot.com/integrations)."
            }
        }
    }
}
